# BLS Configuration File Example
# This file demonstrates the PLUMED-style configuration format for BLS clustering
#
# Usage: bls_analyze --traj trajectory.xtc --conf bls_test.in --out metrics.csv

BLS ...
  # Atom selection: 'all' uses all atoms; can also use ATOMS=1-100 or ATOMS=name:CA
  GROUP ATOMS=all

  # Box mode: AUTO uses trajectory box, or specify MANUAL with xlo,xhi,ylo,yhi,zlo,zhi
  BOX AUTO

  # Voxel grid spacing in Angstroms (smaller = finer resolution, more memory)
  GRID_SPACING 0.3

  # Connectivity mode: 6 (face neighbors) or 26 (face+edge+corner neighbors)
  CONNECTIVITY 6

  # Skip distance for Skip-DFS refinement (larger = faster but may miss connections)
  SKIP 3

  # Alpha scaling factor for auto-computed dNN: dNN = alpha * min(r_i + r_j)
  ALPHA 0.7

  # Explicit nearest-neighbor distance in voxels (0 = auto-compute from RADII and ALPHA)
  DNN 0

  # Atomic radii in Angstroms for auto dNN computation (comma-separated list)
  RADII 1.5,2.0

  # Cutoff radius in Angstroms for rasterization (0 = point-like atoms)
  CUTOFF 0.6

  # Occupancy mode: ANY (atom touches voxel) or ALL (atom fully inside voxel)
  OCCUPANCY ANY

  # Output metrics to report (comma-separated)
  # Available: NCLUSTERS, MAX_CLUSTER, SEED_HITS, SEEDS, REFINED_VOXELS
  OUTPUT NCLUSTERS,MAX_CLUSTER,SEED_HITS,SEEDS,REFINED_VOXELS
... BLS

# Additional notes:
# - Lattice can be specified: LATTICE cubic|hexagonal|triclinic (default: cubic)
# - Centering can be specified: CENTERING P|F|I (default: F)
# - For hexagonal: HEX_C_OVER_A 1.633 (default)
# - For triclinic: TRICLINIC_A/B/C and TRICLINIC_ALPHA/BETA/GAMMA
# - Frame stride: STRIDE 5 (process every 5th frame, default: 1)

